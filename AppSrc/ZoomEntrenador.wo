// C:\DataFlex Projects\FootballApp\AppSrc\ZoomEntrenador.wo
// Entrenador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebCombo.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Object oZoomEntrenador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Entrenador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object oentrenador_DD is a centrenadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To oentrenador_DD
    Set Server  To oentrenador_DD

    // Deja al entrenador sin equipo. Se descartan antes los cambios sin guardar de la ficha
    // (RefreshRecord vuelve a leer el registro), para grabar solo el despido. Despues se vacia el
    // DDO de equipo, como cuando el usuario borra el campo Equipo, y se graba el entrenador: con
    // ParentNullAllowed el DD admite el padre vacio y Save_Main_File graba EquipoID como NULL.
    Procedure DespedirEntrenador
        Integer iRetVal
        Boolean bTieneEquipo
        String sNombre sApellido sEquipo

        Send RefreshRecord

        Get HasRecord of oequipo_DD to bTieneEquipo
        If (not(bTieneEquipo)) Begin
            Procedure_Return
        End

        Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre to sNombre
        Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido to sApellido
        Get Field_Current_Value of oequipo_DD Field equipo.Nombre to sEquipo

        Send Clear of oequipo_DD

        Get Request_Validate of oentrenador_DD to iRetVal
        If (iRetVal <> 0) Begin
            Send RefreshRecord
            Procedure_Return
        End

        Move False to Err
        Send Request_Save of oentrenador_DD
        If (Err) Begin
            Send RefreshRecord
            Procedure_Return
        End

        Send ShowInfoBox ((Trim(sNombre) * Trim(sApellido)) + " ya no es el entrenador de " + Trim(sEquipo) + ".") "Entrenador despedido"
        // Same as after Guardar: back to the view that opened this one.
        Send NavigateClose Self
    End_Procedure


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oentrenadorNombre is a cWebForm
            Entry_Item entrenador.Nombre
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object oentrenadorApellido is a cWebForm
            Entry_Item entrenador.Apellido
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 

        // Combo instead of a form: entrenador.Nacionalidad has a CodeValidationTable in the DD
        // (CodeMast, type NACIONAL), and cWebCombo fills its list from it automatically.
        Object oentrenadorNacionalidad is a cWebCombo
            Entry_Item entrenador.Nacionalidad
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 

        Object oequipoID is a cWebForm
            Entry_Item equipo.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True

            // nfFromChild: el invocador es este campo, cuyo Server es oentrenador_DD (entrenador), y
            // equipo (Main_File de oSelectEquipo) es un servidor suyo: entrenador es hijo de equipo.
            // oSelectEquipo actua como lookup y al elegir fila hace NavigateClose devolviendo el equipo.
            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object

        // Despedir: deja al entrenador sin equipo. Solo se muestra si el entrenador tiene equipo
        // (ver SetActionButtons). Pide confirmacion y despues graba el entrenador con el DDO de
        // equipo vacio; el DD (ParentNullAllowed + Save_Main_File) guarda EquipoID como NULL.
        Object oDespedirBtn is a cWebButton
            Set psCaption to "Despedir"
            Set piColumnSpan to 3
            Set piColumnIndex to 0

            // Callback of the confirmation box (it has to be published to be called from the client).
            Procedure ConfirmarDespedir Integer eRespuesta
                If (eRespuesta = cmYes) Begin
                    Send DespedirEntrenador
                End
            End_Procedure

            WebPublishProcedure ConfirmarDespedir

            Procedure OnClick
                String sNombre sApellido sEquipo

                Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre to sNombre
                Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido to sApellido
                Get Field_Current_Value of oequipo_DD Field equipo.Nombre to sEquipo

                Send ShowYesNo Self (RefProc(ConfirmarDespedir)) ("¿Despedir a " + (Trim(sNombre) * Trim(sApellido)) + " de " + Trim(sEquipo) + "? El entrenador quedará sin equipo.") "Despedir entrenador"
            End_Procedure
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Editar"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Borrar"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Descartar cambios"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord bTieneEquipo
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord
        Get HasRecord of oequipo_DD to bTieneEquipo

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End

        // Despedir is an action of its own (with confirmation), so it is offered both when viewing
        // and when editing, but only for a saved entrenador that has an equipo.
        WebSet pbRender of oDespedirBtn to (bHasRecord and bTieneEquipo)
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons

    End_Procedure

End_Object 
