Use DataDict.pkg

Open jugadorposicion
Open jugador
Open posicion

Class cjugadorposicionDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to jugadorposicion.File_Number

        Set Add_Server_File to jugador.File_Number
        Set Add_Server_File to posicion.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Label_Long Field jugadorposicion.ID to "Código de asignación"
        Set Field_Label_Short Field jugadorposicion.ID to "Código"
        Set Key_Field_State Field jugadorposicion.ID to True
        Set Status_Help Field jugadorposicion.ID to "Código de la asignación. Lo asigna la base de datos."

        Set Field_Label_Long Field jugadorposicion.JugadorID to "Jugador"
        Set Field_Label_Short Field jugadorposicion.JugadorID to "Jugador"
        Set Status_Help Field jugadorposicion.JugadorID to "Jugador al que se asigna la posición."

        Set Field_Label_Long Field jugadorposicion.PosicionID to "Posición"
        Set Field_Label_Short Field jugadorposicion.PosicionID to "Posición"
        Set Status_Help Field jugadorposicion.PosicionID to "Posición que ocupa el jugador."

    End_Procedure

End_Class