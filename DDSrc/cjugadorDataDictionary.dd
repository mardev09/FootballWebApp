Use DataDict.pkg
Use cli.pkg

Open jugador
Open jugadorposicion
Open equipo

Class cjugadorDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to jugador.File_Number

        Set Add_Server_File to equipo.File_Number

        Set Add_Client_File to jugadorposicion.File_Number

        Set ParentNullAllowed equipo.File_Number to True

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Label_Long Field jugador.ID to "Código de jugador"
        Set Field_Label_Short Field jugador.ID to "Código"
        Set Key_Field_State Field jugador.ID to True
        Set Status_Help Field jugador.ID to "Código del jugador. Lo asigna la base de datos."

        Set Field_Label_Long Field jugador.Nombre to "Nombre"
        Set Field_Label_Short Field jugador.Nombre to "Nombre"
        Set Field_Option Field jugador.Nombre DD_REQUIRED to True
        Set Field_Option Field jugador.Nombre DD_COMMIT to True
        Set Status_Help Field jugador.Nombre to "Nombre del jugador. No se puede cambiar una vez guardado."

        Set Field_Label_Long Field jugador.Apellido to "Apellido"
        Set Field_Label_Short Field jugador.Apellido to "Apellido"
        Set Field_Option Field jugador.Apellido DD_REQUIRED to True
        Set Field_Option Field jugador.Apellido DD_COMMIT to True
        Set Status_Help Field jugador.Apellido to "Apellido del jugador. No se puede cambiar una vez guardado."

        Set Field_Label_Long Field jugador.Nacionalidad to "Nacionalidad"
        Set Field_Label_Short Field jugador.Nacionalidad to "Nacionalidad"
        Set Status_Help Field jugador.Nacionalidad to "Nacionalidad del jugador."

        Set Field_Label_Long Field jugador.EquipoID to "Equipo"
        Set Field_Label_Short Field jugador.EquipoID to "Equipo"
        Set Status_Help Field jugador.EquipoID to "Equipo en el que juega. Es opcional (jugador sin equipo)."

    End_Procedure

    // Committed fields (DD_COMMIT) become DD_DISPLAYONLY once the record is saved. By default an
    // indexed field (Apellido) only becomes DD_NOPUT, so the user could still type in it and the
    // change would be silently ignored. Returning True makes it DD_DISPLAYONLY too.
    Function Field_CommitNoEnterOnIndex Integer iField Returns Boolean
        Function_Return True
    End_Function

    // The equipo parent is optional (ParentNullAllowed). With no equipo selected the attach leaves
    // jugador.EquipoID = 0, which is not a valid equipo for the fkJugadorEquipo foreign key, so the
    // column is saved as SQL NULL instead.
    Procedure Save_Main_File
        Handle hoEquipoDD
        Boolean bHasEquipo

        Get Data_Set equipo.File_Number to hoEquipoDD
        If (hoEquipoDD <> 0) Begin
            Get HasRecord of hoEquipoDD to bHasEquipo
            If (not(bHasEquipo)) Begin
                Move 0 to jugador.EquipoID
                Set_Attribute DF_FIELD_IS_NULL of jugador.File_Number (RefTable(jugador.EquipoID)) to True
            End
        End

        Forward Send Save_Main_File
    End_Procedure

End_Class