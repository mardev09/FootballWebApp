Use DataDict.pkg

Open jugador
Open jugadorposicion
Open equipo

Class cjugadorDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to jugador.File_Number

        Set Add_Server_File to equipo.File_Number

        Set Add_Client_File to jugadorposicion.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

    End_Procedure

    // A jugador must belong to an equipo. Without one, Attach leaves jugador.EquipoID = 0 and
    // MariaDB rejects the row through the fkJugadorEquipo foreign key (error 1452). The DD_FINDREQ
    // foreign option only validates visited fields, so an untouched Equipo field slips through.
    // Validate_Save runs before Attach_Main_File, so jugador.EquipoID is not set yet here: check the
    // parent buffer, which the save has already re-found (equipo.ID = 0 means no equipo selected).
    Function Validate_Save Returns Integer
        Integer iRetVal

        Forward Get Validate_Save to iRetVal

        If iRetVal;
            Function_Return iRetVal

        If (equipo.ID = 0) Begin
            Send UserError "Selecciona el equipo del jugador antes de guardar." ""
            Function_Return 1
        End
    End_Function

End_Class